{
    "name": "lenorix/laravel-datadis-client",
    "description": "Laravel integration for lenorix/datadis-client: Datadis electricity data on Laravel's Http, cache and configuration.",
    "keywords": [
        "lenorix",
        "laravel",
        "laravel-datadis-client"
    ],
    "homepage": "https://github.com/lenorix/laravel-datadis-client",
    "license": "Unlicense",
    "authors": [
        {
            "name": "Jesus Hernandez",
            "email": "jesushdez@protonmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/support": "^13.0",
        "lenorix/datadis-client": "^0.3.0",
        "psr/clock": "^1.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "giorgiosironi/eris": "^1.1",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.8",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Lenorix\\LaravelDatadisClient\\": "src/",
            "Lenorix\\LaravelDatadisClient\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lenorix\\LaravelDatadisClient\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "phpstan": "vendor/bin/phpstan analyse",
        "analyse": "@phpstan",
        "test": "vendor/bin/pest",
        "test-pbt": [
            "@putenv DATADIS_PBT_ITERATIONS=2000",
            "vendor/bin/pest tests/Property"
        ],
        "test-coverage": [
            "@putenv XDEBUG_MODE=coverage",
            "vendor/bin/pest --coverage --min=100"
        ],
        "pint": "vendor/bin/pint",
        "format": "@pint",
        "lint": "vendor/bin/pint --test"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Lenorix\\LaravelDatadisClient\\LaravelDatadisClientServiceProvider"
            ],
            "aliases": {
                "LaravelDatadisClient": "Lenorix\\LaravelDatadisClient\\Facades\\LaravelDatadisClient"
            }
        }
    },
    "prefer-stable": true
}
